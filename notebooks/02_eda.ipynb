   "source": [
    "## 9. Outlier Detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Outlier detection using IQR method\n",
    "Q1 = overall['order_item_quantity'].quantile(0.25)\n",
    "Q3 = overall['order_item_quantity'].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = overall[(overall['order_item_quantity'] < lower_bound) | (overall['order_item_quantity'] > upper_bound)]\n",
    "\n",
    "print(f\"Q1: {Q1:.1f}, Q3: {Q3:.1f}, IQR: {IQR:.1f}\")\n",
    "print(f\"Lower bound: {lower_bound:.1f}, Upper bound: {upper_bound:.1f}\")\n",
    "print(f\"Number of outliers: {len(outliers)} ({len(outliers)/len(overall)*100:.1f}%)\")\n",
    "\n",
    "# Visualize outliers\n",
    "fig = px.scatter(overall, x='order_week_start', y='order_item_quantity',\n",
    "                 color=overall['order_item_quantity'].apply(lambda x: 'Outlier' if x < lower_bound or x > upper_bound else 'Normal'),\n",
    "                 title='Weekly Demand with Outliers (IQR Method)',\n",
    "                 labels={'order_week_start': 'Week', 'order_item_quantity': 'Units Sold', 'color': 'Type'})\n",
    "fig.add_hline(y=upper_bound, line_dash='dash', line_color='red', annotation_text='Upper bound')\n",
    "fig.add_hline(y=lower_bound, line_dash='dash', line_color='red', annotation_text='Lower bound')\n",
    "fig.update_layout(height=400, template='plotly_white')\n",
    "fig.show()\n",
    "\n",
    "print(outliers[['order_week_start', 'order_item_quantity']].to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Business Interpretation:** Outliers represent unusual demand spikes or drops. These could be due to promotions, stockouts, data errors, or genuine demand shifts. Outliers should be investigated before modeling - they can distort model parameters if not handled. In forecasting, outliers may be winsorized, modeled separately, or used to trigger alert systems."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Category-level outliers\n",
    "cat_outliers = []\n",
    "for cat_id in cat['category_id'].unique():\n",
    "    cat_data = cat[cat['category_id'] == cat_id]['order_item_quantity']\n",
    "    Q1 = cat_data.quantile(0.25)\n",
    "    Q3 = cat_data.quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    if IQR > 0:\n",
    "        lower = Q1 - 1.5 * IQR\n",
    "        upper = Q3 + 1.5 * IQR\n",
    "        n_outliers = ((cat_data < lower) | (cat_data > upper)).sum()\n",
    "        cat_outliers.append({'category_id': cat_id, 'n_outliers': n_outliers, 'outlier_pct': n_outliers/len(cat_data)*100})\n",
    "\n",
    "cat_outlier_df = pd.DataFrame(cat_outliers).sort_values('outlier_pct', ascending=False)\n",
    "print(cat_outlier_df.head(15).to_string())"
   ]
  },
