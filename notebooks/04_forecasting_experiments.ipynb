{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# DemandCast - Forecasting Experiments\n",
    "\n",
    "Run baseline models, ETS, and XGBoost with rolling-origin backtesting.\n",
    "Evaluate with MAE, RMSE, WAPE, sMAPE, MASE, and Diebold-Mariano tests."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import yaml\n",
    "import json\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Load config\n",
    "with open('../config.yaml', 'r') as f:\n",
    "    config = yaml.safe_load(f)\n",
    "\n",
    "project_root = Path(__file__).parent.parent\n",
    "processed_dir = project_root / config['paths']['processed_data']\n",
    "reports_dir = project_root / config['paths']['reports_dir']\n",
    "models_dir = project_root / config['paths']['models_dir']\n",
    "models_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(f\"Processed data: {processed_dir}\")\n",
    "print(f\"Reports: {reports_dir}\")\n",
    "print(f\"Models: {models_dir}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load category-level demand data\n",
    "cat_data = pd.read_parquet(processed_dir / \"demand_category.parquet\")\n",
    "cat_data['order_week_start'] = pd.to_datetime(cat_data['order_week_start'])\n",
    "cat_data = cat_data.sort_values(['category_id', 'order_week_start'])\n",
    "\n",
    "print(f\"Shape: {cat_data.shape}\")\n",
    "print(f\"Categories: {cat_data['category_id'].nunique()}\")\n",
    "print(f\"Date range: {cat_data['order_week_start'].min()} to {cat_data['order_week_start'].max()}\")\n",
    "\n",
    "# Pick a few categories for testing\n",
    "top_cats = cat_data.groupby('category_id')['order_item_quantity'].sum().nlargest(5).index.tolist()\n",
    "print(f\"\\nTop 5 categories: {top_cats}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build time series for each category\n",
    "from src.evaluation.backtesting import RollingOriginBacktester, backtest_all_models\n",
    "from src.models.baselines import get_all_baselines\n",
    "from src.models.ets_model import ETSForecaster, AutoETS\n",
    "from src.models.xgboost_model import XGBoostForecaster\n",
    "from src.evaluation.metrics import evaluate_forecast, compare_models, diebold_mariano_test\n",
    "\n",
    "# Prepare category time series\n",
    "cat_series = {}\n",
    "for cat_id in top_cats:\n",
    "    cat_df = cat_data[cat_data['category_id'] == cat_id].copy()\n",
    "    cat_df = cat_df.set_index('order_week_start')['order_item_quantity']\n",
    "    cat_df = cat_df.asfreq('W-MON').fillna(0)\n",
    "    cat_series[cat_id] = cat_df\n",
    "\n",
    "print(f\"Prepared {len(cat_series)} category time series\")\n",
    "for cat_id, ts in cat_series.items():\n",
    "    print(f\"  Cat {cat_id}: {len(ts)} weeks, mean={ts.mean():.1f}, std={ts.std():.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run backtest on first category as demo\n",
    "test_cat = top_cats[0]\n",
    "y = cat_series[test_cat]\n",
    "\n",
    "print(f\"Testing on Category {test_cat} (n={len(y)})\")\n",
    "\n",
    "# Backtest parameters\n",
    "HORIZON = 4\n",
    "STEP_SIZE = 4\n",
    "MIN_TRAIN = 52\n",
    "\n",
    "# Get all baseline models\n",
    "baselines = get_all_baselines(seasonal_period=52)\n",
    "print(f\"Baselines: {list(baselines.keys())}\")\n",
    "\n",
    "# Run backtest for baselines\n",
    "backtester = RollingOriginBacktester(horizon=HORIZON, step_size=STEP_SIZE, min_train_size=MIN_TRAIN)\n",
    "\n",
    "baseline_results = {}\n",
    "for name, model in baselines.items():\n",
    "    print(f\"  Backtesting {name}...\")\n",
    "    results = backtester.backtest(y, lambda: model)\n",
    "    baseline_results[name] = results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate baselines\n",
    "from src.evaluation.metrics import evaluate_backtest\n",
    "\n",
    "baseline_metrics = {}\n",
    "for name, results in baseline_results.items():\n",
    "    baseline_metrics[name] = evaluate_backtest(results)\n",
    "\n",
    "metrics_df = pd.DataFrame(baseline_metrics).T\n",
    "metrics_df = metrics_df[['mae', 'rmse', 'wape', 'smape', 'bias']].round(3)\n",
    "metrics_df = metrics_df.sort_values('mae')\n",
    "print(metrics_df.to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run ETS model\n",
    "print(\"\\nRunning ETS...\")\n",
    "ets_model = ETSForecaster(seasonal_period=52)\n",
    "ets_results = backtester.backtest(y, lambda: ets_model)\n",
    "ets_metrics = evaluate_backtest(ets_results)\n",
    "print(f\"ETS ({ets_model.model_type_}): {ets_metrics}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run XGBoost model\n",
    "print(\"\\nRunning XGBoost...\")\n",
    "xgb_model = XGBoostForecaster(horizon=HORIZON, seasonal_period=52)\n",
    "xgb_results = backtester.backtest(y, lambda: xgb_model)\n",
    "xgb_metrics = evaluate_backtest(xgb_results)\n",
    "print(f\"XGBoost: {xgb_metrics}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine all results and compare\n",
    "all_results = {**baseline_results, 'ets': ets_results, 'xgboost': xgb_results}\n",
    "all_metrics = {**baseline_metrics, 'ets': ets_metrics, 'xgboost': xgb_metrics}\n",
    "\n",
    "comparison = pd.DataFrame(all_metrics).T\n",
    "comparison = comparison[['mae', 'rmse', 'wape', 'smape', 'bias']].round(3)\n",
    "comparison = comparison.sort_values('mae')\n",
    "print(comparison.to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Statistical significance: Diebold-Mariano test\n",
    "print(\"\\n=== Diebold-Mariano Tests (vs Best Baseline) ===\")\n",
    "\n",
    "best_baseline = min(baseline_metrics.items(), key=lambda x: x[1]['mae'])[0]\n",
    "print(f\"Best baseline: {best_baseline}\")\n",
    "\n",
    "for model_name in ['ets', 'xgboost']:\n",
    "    if model_name in all_results:\n",
    "        stat, p = diebold_mariano_test(\n",
    "            all_results[best_baseline]['actual'].values,\n",
    "            all_results[best_baseline]['predicted'].values,\n",
    "            all_results[model_name]['predicted'].values\n",
    "        )\n",
    "        print(f\"  {best_baseline} vs {model_name}: DM={stat:.3f}, p={p:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run on all top categories\n",
    "print(\"\\n=== Running on All Top Categories ===\")\n",
    "\n",
    "all_category_results = {}\n",
    "\n",
    "for cat_id in top_cats:\n",
    "    y = cat_series[cat_id]\n",
    "    print(f\"\\nCategory {cat_id}...\")\n",
    "    \n",
    "    cat_backtester = RollingOriginBacktester(horizon=HORIZON, step_size=STEP_SIZE, min_train_size=MIN_TRAIN)\n",
    "    \n",
    "    # Baselines\n",
    "    cat_results = {}\n",
    "    cat_metrics = {}\n",
    "    \n",
    "    for name, model in baselines.items():\n",
    "        try:\n",
    "            res = cat_backtester.backtest(y, lambda: model)\n",
    "            cat_results[name] = res\n",
    "            cat_metrics[name] = evaluate_backtest(res)\n",
    "        except Exception as e:\n",
    "            print(f\"    {name} failed: {e}\")\n",
    "    \n",
    "    # ETS\n",
    "    try:\n",
    "        res = cat_backtester.backtest(y, lambda: ETSForecaster(seasonal_period=52))\n",
    "        cat_results['ets'] = res\n",
    "        cat_metrics['ets'] = evaluate_backtest(res)\n",
    "    except Exception as e:\n",
    "        print(f\"    ETS failed: {e}\")\n",
    "    \n",
    "    # XGBoost\n",
    "    try:\n",
    "        res = cat_backtester.backtest(y, lambda: XGBoostForecaster(horizon=HORIZON, seasonal_period=52))\n",
    "        cat_results['xgboost'] = res\n",
    "        cat_metrics['xgboost'] = evaluate_backtest(res)\n",
    "    except Exception as e:\n",
    "        print(f\"    XGBoost failed: {e}\")\n",
    "    \n",
    "    all_category_results[cat_id] = {\n",
    "        'results': cat_results,\n",
    "        'metrics': cat_metrics\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Aggregate metrics across categories\n",
    "print(\"\\n=== Average Metrics Across Categories ===\")\n",
    "\n",
    "avg_metrics = {}\n",
    "for model_name in ['naive', 'seasonal_naive', 'moving_avg_4', 'moving_avg_12', 'historical_avg', 'ensemble', 'ets', 'xgboost']:\n",
    "    maes = []\n",
    "    rmses = []\n",
    "    for cat_id in top_cats:\n",
    "        if model_name in all_category_results[cat_id]['metrics']:\n",
    "            m = all_category_results[cat_id]['metrics'][model_name]\n",
    "            maes.append(m['mae'])\n",
    "            rmses.append(m['rmse'])\n",
    "    if maes:\n",
    "        avg_metrics[model_name] = {\n",
    "            'avg_mae': np.mean(maes),\n",
    "            'std_mae': np.std(maes),\n",
    "            'avg_rmse': np.mean(rmses),\n",
    "            'std_rmse': np.std(rmses),\n",
    "        }\n",
    "\n",
    "avg_df = pd.DataFrame(avg_metrics).T.round(3)\n",
    "avg_df = avg_df.sort_values('avg_mae')\n",
    "print(avg_df.to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Win counts: how often each model beats baselines\n",
    "print(\"\\n=== Win Counts (lower MAE = win) ===\")\n",
    "\n",
    "wins = {model: 0 for model in ['ets', 'xgboost']}\n",
    "baseline_names = ['naive', 'seasonal_naive', 'moving_avg_4', 'moving_avg_12', 'historical_avg', 'ensemble']\n",
    "\n",
    "for cat_id in top_cats:\n",
    "    cat_metrics = all_category_results[cat_id]['metrics']\n",
    "    \n",
    "    for model in ['ets', 'xgboost']:\n",
    "        if model in cat_metrics:\n",
    "            model_mae = cat_metrics[model]['mae']\n",
    "            # Count how many baselines it beats\n",
    "            for b in baseline_names:\n",
    "                if b in cat_metrics and model_mae < cat_metrics[b]['mae']:\n",
    "                    wins[model] += 1\n",
    "\n",
    "print(wins)")
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save best model for each category\n",
    "print(\"\\n=== Best Model Per Category ===\")\n",
    "\n",
    "best_models = {}\n",
    "for cat_id in top_cats:\n",
    "    cat_metrics = all_category_results[cat_id]['metrics']\n",
    "    best = min(cat_metrics.items(), key=lambda x: x[1]['mae'])\n",
    "    best_models[cat_id] = best[0]\n",
    "    print(f\"  Cat {cat_id}: {best[0]} (MAE={best[1]['mae']:.2f})\")\n",
    "\n",
    "# Save experiment results\n",
    "experiment_results = {\n",
    "    'config': {\n",
    "        'horizon': HORIZON,\n",
    "        'step_size': STEP_SIZE,\n",
    "        'min_train': MIN_TRAIN,\n",
    "        'categories_tested': top_cats,\n",
    "    },\n",
    "    'average_metrics': avg_metrics,\n",
    "    'wins': wins,\n",
    "    'best_per_category': best_models,\n",
    "}\n",
    "\n",
    "with open(reports_dir / 'forecasting_experiment_results.json', 'w') as f:\n",
    "    json.dump(experiment_results, f, indent=2, default=str)\n",
    "\n",
    "print(f\"\\nResults saved to {reports_dir / 'forecasting_experiment_results.json'}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Final model training on full data for selected categories\n",
    "print(\"\\n=== Final Model Training (Full Data) ===\")\n",
    "\n",
    "import joblib\n",
    "\n",
    "final_models = {}\n",
    "\n",
    "for cat_id in top_cats:\n",
    "    y = cat_series[cat_id]\n",
    "    best_model_name = best_models[cat_id]\n",
    "    \n",
    "    if best_model_name == 'ets':\n",
    "        model = ETSForecaster(seasonal_period=52).fit(y)\n",
    "    elif best_model_name == 'xgboost':\n",
    "        model = XGBoostForecaster(horizon=HORIZON, seasonal_period=52).fit(y)\n",
    "    else:\n",
    "        # Use best baseline\n",
    "        baselines = get_all_baselines(seasonal_period=52)\n",
    "        model = baselines[best_model_name].fit(y)\n",
    "    \n",
    "    final_models[cat_id] = {\n",
    "        'model': model,\n",
    "        'model_type': best_model_name,\n",
    "        'horizon': HORIZON,\n",
    "        'trained_on': len(y),\n",
    "        'last_date': str(y.index[-1]),\n",
    "    }\n",
    "    \n",
    "    # Save model\n",
    "    joblib.dump(model, models_dir / f\"model_cat_{cat_id}.joblib\")\n",
    "\n",
    "print(\"Models saved to models/\")"
   ]
  }
 ],
